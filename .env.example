# Copy to .env (git-ignored). docker compose reads it automatically.

# Host port for the Postgres container. Use 5433 if a local PostgreSQL service already owns 5432.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mindmesh

# development (public dev API key allowed) | production (requires the secrets below)
MINDMESH_ENV=development
# MINDMESH_API_KEY=        # >= 32 chars in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MINDMESH_SECRET_KEY=     # >= 32 chars in production; signs stream tokens

# Agents on a local open-weight model (docker compose --profile llm up -d)
# MINDMESH_MODEL=ollama:qwen3:8b
# MINDMESH_EMBEDDER=ollama:nomic-embed-text
